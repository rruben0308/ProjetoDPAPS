# Copie para .env e preencha com a URL do Neon (NUNCA commitar o .env):
#   copy .env.example .env
#
# No painel Neon: Connect → Postgres → copie a connection string (Show password).
# Preferir conexão DIRETA (sem "-pooler") no MVP.
# Se a conexão Python falhar com channel_binding, use só ?sslmode=require

# --- Neon (padrão do projeto — substitui Docker) ---
DATABASE_URL=postgresql://neondb_owner:SUA_SENHA@ep-XXXX.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- LLM (T-006) — padrão: none + template (custo zero) ---
LLM_PROVIDER=none
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Paths ---
DATA_DIR=data
RAW_PDFS_DIR=data/raw_pdfs
TEXTS_DIR=data/texts
OUTPUTS_DIR=data/outputs

# --- Embeddings (T-020+) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# auto = tenta MiniLM; se HuggingFace bloquear, usa hashing offline
EMBEDDING_BACKEND=auto

# --- Auth (login / sessao) ---
AUTH_SECRET=troque-este-segredo-em-producao
AUTH_TOKEN_TTL_HOURS=72
AUTH_RESET_TTL_MINUTES=60
APP_PUBLIC_URL=http://127.0.0.1:8000

# --- E-mail (opcional; sem SMTP o link de reset aparece na tela em dev) ---
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@exemplo.com
# SMTP_USE_TLS=true

